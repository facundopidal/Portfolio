---
import { Image } from "astro:assets";
import isdImage from "@assets/images/isd.png";
---

<section
  id="featured-projects"
  class="py-20 px-4 bg-light-bg dark:bg-dark-bg text-light-text dark:text-dark-text animate-on-scroll"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-4xl font-bold text-center">Proyectos Destacados</h2>

    <div class="mt-12 grid grid-cols-1 gap-12">
      <!-- Proyecto 1 -->
      <div
        class="bg-light-secondary/10 dark:bg-dark-secondary/10 rounded-lg shadow-lg overflow-hidden"
      >
        <div class="md:flex">
          <div class="md:w-1/2 p-8">
            <h3 class="text-2xl font-bold">Instituto Salvador Dalí</h3>
            <p class="mt-4 text-light-secondary dark:text-dark-secondary">
              Diseño y desarrollo del sitio web institucional para un jardín de
              infantes, mejorando la comunicación con la comunidad y facilitando
              el acceso a la información.
            </p>
            <div class="mt-6">
              <a
                href="http://www.institutosalvadordali.com.ar"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-light-accent text-light-bg dark:bg-dark-accent dark:text-dark-bg font-bold py-2 px-4 rounded-lg hover:opacity-90 transition-opacity"
              >
                Visitar Sitio Web
              </a>
            </div>
          </div>
          <div class="md:w-1/2 flex items-center justify-center">
            <Image
              src={isdImage}
              alt="Captura de pantalla del sitio web del Instituto Salvador Dalí"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
