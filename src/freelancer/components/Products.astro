---
import { Image } from "astro:assets";
import multiwImage from "@assets/images/multiw.png";
---

<section
  id="products"
  class="py-20 px-4 bg-light-bg dark:bg-dark-bg text-light-text dark:text-dark-text animate-on-scroll"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-4xl font-bold text-center">Mis Productos (SaaS)</h2>

    <div class="mt-12 grid grid-cols-1 gap-12">
      <!-- Producto 1 -->
      <div
        class="bg-light-secondary/10 dark:bg-dark-secondary/10 rounded-lg shadow-lg overflow-hidden"
      >
        <div class="md:flex">
          <div class="md:w-1/2 p-8">
            <h3 class="text-2xl font-bold">Multi WhatsApp</h3>
            <p class="mt-4 text-light-secondary dark:text-dark-secondary">
              Aplicación de escritorio para Windows que permite gestionar
              múltiples sesiones de WhatsApp de forma concurrente y aislada,
              ideal para negocios y equipos que necesitan centralizar la
              comunicación.
            </p>
            <div class="mt-6">
              <a
                href="https://multiwa.netlify.app"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-light-accent text-light-bg dark:bg-dark-accent dark:text-dark-bg font-bold py-2 px-4 rounded-lg hover:opacity-90 transition-opacity"
              >
                Ver más
              </a>
            </div>
          </div>
          <div class="md:w-1/2 flex items-center justify-center">
            <Image
              src={multiwImage}
              alt="Imagen de la aplicación Multi WhatsApp"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
