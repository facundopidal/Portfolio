---
import ThemeToggle from "./ThemeToggle.astro";
const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Work', href: '/work/' },
	{ label: 'About', href: '/about/' },
];
---
<header class="sticky top-0 z-50 w-full p-4 bg-light-bg/80 dark:bg-dark-bg/80 backdrop-blur-lg border-b border-light-secondary/20 dark:border-dark-secondary/20">
    <nav class="flex justify-between items-center max-w-4xl mx-auto">
        <a href="/" class="text-2xl font-bold text-light-text dark:text-dark-text">
            Facundo Pidal
        </a>
        <div class="flex items-center gap-4">
            <ul class="flex gap-4">
                {textLinks.map(link => (
                    <li>
                        <a href={link.href} class="text-light-secondary dark:text-dark-secondary hover:text-light-accent dark:hover:text-dark-accent transition-colors">
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
            <ThemeToggle />
        </div>
    </nav>
</header>
