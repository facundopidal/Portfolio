---
import { skills } from "../data/skills.ts";
---

<section id="skills" class="py-20 px-4 bg-light-bg dark:bg-dark-bg text-light-text dark:text-dark-text">
  <h2
    class="text-4xl font-bold text-center text-light-text dark:text-dark-text"
  >
    Tecnologías
  </h2>
  <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
    <div
      class="bg-light-bg dark:bg-dark-bg border border-light-secondary/20 dark:border-dark-secondary/20 p-8 rounded-lg"
    >
      <h3 class="text-2xl font-bold text-light-text dark:text-dark-text">
        Frontend
      </h3>
      <ul class="mt-4 space-y-2">
        {
          skills.frontend.map((skill) => (
            <li class="flex items-center">
              <img
                src={`/icons/${skill.id}.png`}
                alt={skill.name}
                class="w-6 h-6 mr-4"
                class:list={[{ "dark:invert": skill.id === "astro" }]}
              />
              <span class="text-light-secondary dark:text-dark-secondary">
                {skill.name}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="bg-light-bg dark:bg-dark-bg border border-light-secondary/20 dark:border-dark-secondary/20 p-8 rounded-lg"
    >
      <h3 class="text-2xl font-bold text-light-text dark:text-dark-text">
        Backend
      </h3>
      <ul class="mt-4 space-y-2">
        {
          skills.backend.map((skill) => (
            <li class="flex items-center">
              <img
                src={`/icons/${skill.id}.png`}
                alt={skill.name}
                class="w-6 h-6 mr-4"
              />
              <span class="text-light-secondary dark:text-dark-secondary">
                {skill.name}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="bg-light-bg dark:bg-dark-bg border border-light-secondary/20 dark:border-dark-secondary/20 p-8 rounded-lg"
    >
      <h3 class="text-2xl font-bold text-light-text dark:text-dark-text">
        Other
      </h3>
      <ul class="mt-4 space-y-2">
        {
          skills.otros.map((skill) => (
            <li class="flex items-center">
              <img
                src={`/icons/${skill.id}.png`}
                alt={skill.name}
                class="w-6 h-6 mr-4"
              />
              <span class="text-light-secondary dark:text-dark-secondary">
                {skill.name}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
